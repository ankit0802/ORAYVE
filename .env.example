# ORAYVE ENTERPRISE PLATFORM CONFIGURATION

# Server Port
PORT=8080

# Live Database (Neon Free 1GB PostgreSQL 16)
# Get your free connection string from https://console.neon.tech
NEON_DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-snow-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Auth Secret
JWT_SECRET=orayve-production-super-secret-key-replace-with-random-hex-32-bytes

# AES-256-GCM Encryption Key (for Gov ID & PAN at rest)
ENCRYPTION_SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Razorpay Payments (Test / Live)
RAZORPAY_KEY_ID=rzp_test_orayve_demo
